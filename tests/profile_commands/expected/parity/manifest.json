{
  "comparators": [
    {
      "id": "lot5-py/step-outcomes",
      "kind": "parity",
      "note": "One headless bridge per case: create it with the descriptors artifact (or the bridge input), load the envelope input (with importedDi when given) and activate the compiled profileArtifact, each result matching the setup outcomes; then run the sequence steps in order. Every actual result equals its outcome template under profile-c14n/2 after each {$unsealed} marker is replaced by the actual member it marks (the member must exist); equal/differ compare a pointer with a saved result; signal results match per action. Placeholders {$current} and {$saved} are resolved before the request runs (SPEC_PROFILE_COMMANDS_PY.md section 8)."
    },
    {
      "id": "lot5-py/compile-outcome",
      "kind": "parity",
      "note": "loadProfile then compileProfile on the profileArtifact bytes with the base and descriptors artifacts: the first refusal as {status, code, diagnostics}, or {status: ok, identity, diagnostics} with identity the compiled profile identity record."
    },
    {
      "id": "profile-c14n/2",
      "kind": "mechanism",
      "note": "RFC 8785 JCS bytes, UTF-16 key order (DESIGN R3.3 \u00a73.1)."
    },
    {
      "id": "stable-id/1",
      "kind": "mechanism",
      "note": "Allocated IDs recompute (DESIGN R3.3 \u00a73.2)."
    }
  ],
